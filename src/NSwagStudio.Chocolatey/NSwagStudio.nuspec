<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2011/08/nuspec.xsd">
  <metadata>
    <id>Monigass.NSwagStudio</id>
    <title>NSwagStudio</title>
    <version>1.0.0</version>
    <authors>Rico Suter</authors>
    <owners>Monigass</owners>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <licenseUrl>https://github.com/Monigass/NSwag/blob/master/LICENSE.md</licenseUrl>
    <projectUrl>https://github.com/Monigass/NSwag</projectUrl>
    <iconUrl>https://cdn.jsdelivr.net/gh/Monigass/NSwag@master/assets/NuGetIcon.png</iconUrl>
    <description>This package distributes Monigass's fork of NSwagStudio, based on NSwag originally created by Rico Suter. It is not the upstream NSwagStudio package. NSwag is the OpenAPI/Swagger API toolchain for .NET and TypeScript.</description>
    <tags>OpenAPI Swagger AspNetCore Documentation CodeGen TypeScript WebApi AspNet admin</tags>
    <dependencies />
    <references />
  </metadata>
  <files>
    <file src="..\..\artifacts\bin\NSwagStudio.Installer\$configuration$\NSwagStudio.msi" target="tools"/>

    <file src="chocolateyInstall.ps1" target="tools"/>
    <file src="chocolateyUninstall.ps1" target="tools"/>

    <file src="LICENSE.txt" target="tools"/>
    <file src="VERIFICATION.txt" target="tools"/>
  </files>
</package>